// conf/test.config
/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow config file for running tests with full data
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Uses full dataset with limited resources for testing.
    Use as follows:
        nextflow run nf-core/multistep-peak-annotation -profile test,<docker/singularity> --outdir <OUTDIR>
----------------------------------------------------------------------------------------
*/

params {
    config_profile_name        = 'Test profile'
    config_profile_description = 'Full dataset test with limited resources'

    // Limited resources for testing environment
    max_cpus   = 4
    max_memory = '16.GB'
    max_time   = '4.h'

    // Full input data from assets folder
    input = "${projectDir}/assets/test_data/samplesheet.csv"

    // Annotation files
    gtf        = "${projectDir}/assets/test_data/annotations/drosophila.gtf"
    crm_bed    = "${projectDir}/assets/test_data/annotations/crm_regions.bed"
    intron_bed = "${projectDir}/assets/test_data/annotations/first_intron_regions.bed"

    // Peak calling options
    min_consensus_reps = 2
    skip_consensus     = false

    // Use dm6 built-in HOMER genome
    homer_genome = 'dm6'
    species      = 'drosophila_melanogaster'

    // Standard options for testing
    enable_lncrna_mirna_expansion = false
    auto_download_references      = true

    // Annotation options
    skip_crm    = false
    skip_intron = false
    homer_distance = 1000
    intersect_overlap_fraction = 0.0
}


