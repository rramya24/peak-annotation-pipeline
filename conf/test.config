/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow config file for running minimal tests
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Defines input files and everything required to run a fast and simple pipeline test.

    Use as follows:
        nextflow run nf-core/peak-annotation-pipeline -profile test,<docker/singularity> --outdir <OUTDIR>

----------------------------------------------------------------------------------------
*/

params {
    config_profile_name        = 'Test profile'
    config_profile_description = 'Minimal test dataset to check pipeline function'

    // Limit resources so that this can run on GitHub Actions
    max_cpus   = 2
    max_memory = '6.GB'
    max_time   = '6.h'

    // Input data - use the test samplesheet from your assets
    input  = "${projectDir}/assets/test_data/samplesheet.csv"

    // Genome references - ENABLE auto-download to fix the error
    genome                    = 'dm6'
    auto_download_references  = true    // Enable auto-download for GTF
    ensembl_version          = 114      // Latest version
    species                  = 'drosophila_melanogaster'

    // Use your local test files from assets
    crm_bed    = "${projectDir}/assets/test_data/annotations/crm_bed_file_dm6_redfly.bed"
    intron_bed = "${projectDir}/assets/test_data/annotations/first_intron_dm6.bed"

    // Minimal annotation settings for quick test
    min_consensus_reps              = 2
    homer_distance                  = 1000
    intersect_overlap_fraction      = 0.0

    // Enable basic features for testing
    enable_lncrna_mirna_expansion   = false  // Skip for minimal test
    skip_crm                        = false  // Test CRM annotation
    skip_intron                     = false  // Test intron annotation
    skip_multiqc                    = true   // Skip MultiQC for speed
}
