/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow config file for running full-size tests
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Defines input files and everything required to run a full size pipeline test.
    Use as follows:
        nextflow run nf-core/multistep-peak-annotation -profile test_full,<docker/singularity> --outdir <OUTDIR>
----------------------------------------------------------------------------------------
*/

params {
    config_profile_name        = 'Full test profile'
    config_profile_description = 'Full size test dataset to check pipeline function'

    // Full test resources
    max_cpus   = 16
    max_memory = '128.GB'
    max_time   = '12.h'

    // Input data - use the test samplesheet from your assets
    input = "${projectDir}/assets/test_data/samplesheet.csv"

    // Genome settings
    genome                    = 'dm6'
    auto_download_references  = true
    ensembl_version          = 114
    species                  = 'drosophila_melanogaster'

    // Annotation files - use your local test files from assets
    crm_bed    = "${projectDir}/assets/test_data/annotations/crm_bed_file_dm6_redfly.bed"
    intron_bed = "${projectDir}/assets/test_data/annotations/first_intron_dm6.bed"

    // Peak calling options
    min_consensus_reps = 2
    skip_consensus     = false

    // Enable ALL features for comprehensive testing
    enable_lncrna_mirna_expansion = true   // Test lncRNA-miRNA expansion
    auto_download_references      = true

    // Annotation options - test everything
    skip_crm    = false    // Test CRM annotation
    skip_intron = false    // Test intron annotation
    skip_homer  = false    // Test HOMER annotation
    homer_distance = 1000
    intersect_overlap_fraction = 0.0

    // Enable MultiQC for full reporting
    skip_multiqc = false
}
