// conf/modules.config
/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Config file for defining DSL2 per module options and publishing paths
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Available keys to override module options:
        ext.args   = Additional arguments appended to command in module.
        ext.args2  = Second set of arguments appended to command in module (multi-tool modules).
        ext.args3  = Third set of arguments appended to command in module (multi-tool modules).
        ext.prefix = File name prefix for output files.
        ext.suffix = File name suffix for output files.
        publishDir = Path to publish module results relative to process.publishDir.
----------------------------------------------------------------------------------------
*/

process {

    publishDir = [
        path: { "${params.outdir}/${task.process.tokenize(':')[-1].tokenize('_')[0].toLowerCase()}" },
        mode: params.publish_dir_mode,
        saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
    ]

    withName: CUSTOM_DUMPSOFTWAREVERSIONS {
        publishDir = [
            path: { "${params.outdir}/pipeline_info" },
            mode: params.publish_dir_mode,
            pattern: '*_versions.yml'
        ]
    }

    // Bedtools intersect configurations
    withName: 'BEDTOOLS_INTERSECT.*CRM' {
        ext.args = '-wa -wb'
        ext.prefix = { "${meta.id}.crm_intersect" }
        publishDir = [
            path: { "${params.outdir}/bedtools_intersect/crm" },
            mode: params.publish_dir_mode,
            pattern: '*.bed'
        ]
    }

    withName: 'BEDTOOLS_INTERSECT.*INTRON' {
        ext.args = '-wa -wb'
        ext.prefix = { "${meta.id}.intron_intersect" }
        publishDir = [
            path: { "${params.outdir}/bedtools_intersect/intron" },
            mode: params.publish_dir_mode,
            pattern: '*.bed'
        ]
    }

    // HOMER annotation with UCL Myriad optimization
    withName: HOMER_ANNOTATEPEAKS {
        cpus   = { check_max( 2 * task.attempt, 'cpus' ) }
        memory = { check_max( 8.GB * task.attempt, 'memory' ) }
        time   = { check_max( 2.h * task.attempt, 'time' ) }

        errorStrategy = { task.exitStatus in [1,143,137,104,134,139] ? 'retry' : 'finish' }
        maxRetries = 3

        ext.args = { "-size ${params.homer_distance ?: 1000}" }
        ext.prefix = { "${meta.id}.homer_annotated" }

        publishDir = [
            path: { "${params.outdir}/homer_annotation" },
            mode: params.publish_dir_mode,
            pattern: '*.txt'
        ]
    }

    // Consensus peak calling
    withName: BEDTOOLS_MERGE {
        ext.args = '-c 4,5,6 -o distinct,mean,distinct'
        ext.prefix = { "${meta.id}.consensus" }
        publishDir = [
            path: { "${params.outdir}/consensus_peaks" },
            mode: params.publish_dir_mode,
            pattern: '*.bed'
        ]
    }

    // MultiQC
    withName: MULTIQC {
        ext.args   = { params.multiqc_title ? "--title \"$params.multiqc_title\"" : '' }
        publishDir = [
            path: { "${params.outdir}/multiqc" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    // Additional resource optimizations for UCL Myriad
    withLabel: process_low {
        cpus   = { check_max( 2 * task.attempt, 'cpus' ) }
        memory = { check_max( 6.GB * task.attempt, 'memory' ) }
        time   = { check_max( 4.h * task.attempt, 'time' ) }
    }

    withLabel: process_medium {
        cpus   = { check_max( 6 * task.attempt, 'cpus' ) }
        memory = { check_max( 36.GB * task.attempt, 'memory' ) }
        time   = { check_max( 8.h * task.attempt, 'time' ) }
    }

    withLabel: process_high {
        cpus   = { check_max( 12 * task.attempt, 'cpus' ) }
        memory = { check_max( 72.GB * task.attempt, 'memory' ) }
        time   = { check_max( 16.h * task.attempt, 'time' ) }
    }

    withLabel: process_long {
        time   = { check_max( 20.h * task.attempt, 'time' ) }
    }

    withLabel: process_high_memory {
        memory = { check_max( 200.GB * task.attempt, 'memory' ) }
    }

    // Error retry strategy for all processes on UCL Myriad
    withLabel: error_retry {
        errorStrategy = { task.exitStatus in [143,137,104,134,139] ? 'retry' : 'finish' }
        maxRetries    = 2
    }
}

// GTF Download configuration
withName: DOWNLOAD_GTF {
    cpus   = { check_max( 1 * task.attempt, 'cpus' ) }
    memory = { check_max( 4.GB * task.attempt, 'memory' ) }
    time   = { check_max( 1.h * task.attempt, 'time' ) }

    errorStrategy = { task.exitStatus in [1,143,137,104,134,139] ? 'retry' : 'finish' }
    maxRetries = 3

    publishDir = [
        path: { "${params.outdir}/references" },
        mode: params.publish_dir_mode,
        saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
    ]
}

// GUNZIP for GTF decompression
withName: GUNZIP {
    publishDir = [
        path: { "${params.outdir}/references" },
        mode: params.publish_dir_mode,
        saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
    ]
}
